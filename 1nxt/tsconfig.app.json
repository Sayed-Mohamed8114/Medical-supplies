{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "composite": true,
    "noEmit": false,
    "types": ["node"],

    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}